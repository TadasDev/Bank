{% extends 'base.html.twig' %}

{% block title %}Dashboard - Investment & Lending Platform{% endblock %}

{% block body %}
    <div class="container-fluid px-4">
        <!-- Welcome Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="display-6 fw-semibold mb-1">Welcome, {{ app.user.firstName }}</h1>
                <p class="text-muted fs-5 mb-0">Manage your investments and loans</p>
            </div>
        </div>

        <!-- Paysera Connection Alert -->
        {% if not app.user.hasPayseraConnected %}
        <div class="alert alert-warning border-0 shadow-sm mb-4">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                    <i class="bi bi-bank text-warning fs-4"></i>
                </div>
                <div class="flex-grow-1">
                    <h5 class="mb-1">Connect Your Paysera Account</h5>
                    <p class="mb-0">To start investing, you'll need to connect your Paysera account for secure transactions.</p>
                </div>
                <div class="ms-3">
                    <a href="{{ path('app_connect_paysera') }}" class="btn btn-warning">
                        <i class="bi bi-bank me-2"></i>Connect Now
                    </a>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Quick Stats -->
        <div class="row g-4 mb-4">
            {% if app.user.isInvestor %}
            <!-- Investor Stats -->
            <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                    <i class="bi bi-piggy-bank text-success fs-4"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                            </div>
                            <h3 class="fs-2 fw-bold mb-1">$0</h3>
                            <p class="text-muted mb-0">Total Invested</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                    <i class="bi bi-graph-up-arrow text-primary fs-4"></i>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary">0%</span>
                            </div>
                            <h3 class="fs-2 fw-bold mb-1">$0</h3>
                            <p class="text-muted mb-0">Total Returns</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="row g-4">
            {% if not app.user.isInvestor %}
            <!-- Investment Section -->
            <div class="col-12">
                <!-- Paysera Connection Check -->
                {% if not app.user.hasPayseraConnected %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center py-5">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-4 d-inline-block mb-3">
                            <i class="bi bi-bank text-warning fs-1"></i>
                        </div>
                        <h2 class="fs-4 fw-semibold mb-3">Connect Your Paysera Account</h2>
                        <p class="text-muted mb-4">To start investing in projects, you'll need to connect your Paysera account.</p>
                        <div class="row g-4 justify-content-center mb-4">
                            <div class="col-md-6">
                                <div class="p-3 rounded bg-light">
                                    <i class="bi bi-shield-check text-warning fs-3 mb-2"></i>
                                    <h3 class="fs-5 fw-semibold">Secure Transactions</h3>
                                    <p class="text-muted small mb-0">Make secure investments with bank-level protection</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded bg-light">
                                    <i class="bi bi-lightning-charge text-warning fs-3 mb-2"></i>
                                    <h3 class="fs-5 fw-semibold">Instant Transfers</h3>
                                    <p class="text-muted small mb-0">Transfer funds instantly to your investment account</p>
                                </div>
                            </div>
                        </div>
                        <a href="{{ path('app_connect_paysera') }}" class="btn btn-warning btn-lg px-5">
                            <i class="bi bi-bank me-2"></i>Connect Paysera Account
                        </a>
                    </div>
                </div>
                {% endif %}
                <!-- Investment Dashboard -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Your Investments</h5>
                            <button class="btn btn-outline-success btn-sm">View All</button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <!-- Investment Items -->
                            <div class="list-group-item px-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded bg-success bg-opacity-10 p-3 me-3">
                                        <i class="bi bi-building text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">Investment No:255</h6>
                                        <p class="text-muted small mb-0">Investment: $15,000 | ROI: 12%</p>
                                    </div>
                                    <div class="text-end ms-3">
                                        <div class="fw-bold text-success">Active</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Opportunities Section -->
            {% if app.user.isInvestor %}
            <div class="col-12">
                <!-- Investment Opportunities -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">Investment Opportunities</h5>
                    </div>
                    <div class="card-body">
                        {% if not app.user.hasPayseraConnected %}
                            <div class="text-center py-4">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-inline-block mb-3">
                                    <i class="bi bi-lock text-warning fs-3"></i>
                                </div>
                                <h6 class="mb-2">Connect Paysera to View</h6>
                                <p class="text-muted small mb-0">Investment opportunities will be available after connecting your Paysera account</p>
                            </div>
                        {% else %}
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded bg-success bg-opacity-10 p-2 me-3">
                                    <i class="bi bi-building-up text-success"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1">Investment No:255</h6>
                                    <small class="text-muted">Min: $5,000 | ROI: 15%</small>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
               {% endif %}
        </div>
    </div>
{% endblock %}
