{% extends 'base.html.twig' %}

{% block title %}Connect Paysera Account - InvestmentPro{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="display-6 fw-semibold mb-3">Connect Your Paysera Account</h1>
                <p class="text-muted fs-5">To start investing, you'll need to connect your Paysera account for secure transactions</p>
            </div>

            <!-- Connection Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="rounded-circle bg-success bg-opacity-10 p-4 d-inline-block mb-3">
                            <i class="bi bi-bank fs-1 text-success"></i>
                        </div>
                        <h2 class="fs-3 fw-semibold mb-3">Why Connect Paysera?</h2>
                        <p class="text-muted mb-0">Connecting your Paysera account enables you to:</p>
                    </div>

                    <!-- Benefits -->
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="p-4 rounded bg-light">
                                <i class="bi bi-shield-check text-success fs-3 mb-3"></i>
                                <h3 class="fs-5 fw-semibold">Secure Investments</h3>
                                <p class="text-muted small mb-0">Make secure transactions with bank-level security</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-4 rounded bg-light">
                                <i class="bi bi-lightning-charge text-success fs-3 mb-3"></i>
                                <h3 class="fs-5 fw-semibold">Instant Transfers</h3>
                                <p class="text-muted small mb-0">Transfer funds instantly to your investment account</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-4 rounded bg-light">
                                <i class="bi bi-graph-up-arrow text-success fs-3 mb-3"></i>
                                <h3 class="fs-5 fw-semibold">Track Returns</h3>
                                <p class="text-muted small mb-0">Automatically receive and track your investment returns</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-4 rounded bg-light">
                                <i class="bi bi-clock-history text-success fs-3 mb-3"></i>
                                <h3 class="fs-5 fw-semibold">Transaction History</h3>
                                <p class="text-muted small mb-0">View complete history of your investments</p>
                            </div>
                        </div>
                    </div>

                    <!-- Connection Button -->
                    <div class="mb-4">
                        <a href="{{ path('app_connect_paysera') }}" class="btn btn-success btn-lg px-5 py-3">
                            <i class="bi bi-bank me-2"></i>Connect Paysera Account
                        </a>
                    </div>

                    <!-- Security Note -->
                    <div class="text-muted small">
                        <i class="bi bi-shield-lock me-2"></i>
                        Your banking information is securely handled through Paysera's official API
                    </div>
                </div>
            </div>

            <!-- FAQ Section -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <h3 class="fs-4 fw-semibold mb-4">Frequently Asked Questions</h3>
                    
                    <div class="accordion" id="payseraFAQ">
                        <div class="accordion-item border-0 mb-3">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    Is it secure to connect my Paysera account?
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#payseraFAQ">
                                <div class="accordion-body text-muted">
                                    Yes, we use Paysera's official API with bank-level security. Your banking information is never stored on our servers.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item border-0 mb-3">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    How long does it take to connect?
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#payseraFAQ">
                                <div class="accordion-body text-muted">
                                    The connection process typically takes less than 5 minutes. You'll be redirected to Paysera to authorize the connection.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item border-0">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    Can I disconnect my account later?
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#payseraFAQ">
                                <div class="accordion-body text-muted">
                                    Yes, you can disconnect your Paysera account at any time from your account settings.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
